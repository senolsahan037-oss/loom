{
  "_note": "Clip-protection cases the extension bridge (extension/src/bridge.ts) runs against its fake Live in tests/bridge.test.ts. A fake set has one MIDI track 'BASS' with a user clip 'user riff' at beats 32-48 and one Loom-owned clip 'Verse' at 64-80 (recorded in the ownership ledger).",
  "cases": [
    {"id": "invalid_pitch_refused_before_any_write", "payload": {"op": "write_arrangement_clip", "track": "BASS", "start_beat": 0, "length_beats": 8, "name": "X", "notes": [{"pitch": 200, "start": 0, "duration": 1, "velocity": 100}]}, "expect": "refused", "reason_contains": "pitch"},
    {"id": "non_finite_start_refused", "payload": {"op": "write_arrangement_clip", "track": "BASS", "start_beat": 0, "length_beats": 8, "name": "X", "notes": [{"pitch": 60, "start": "nan", "duration": 1, "velocity": 100}]}, "expect": "refused", "reason_contains": "start"},
    {"id": "note_past_clip_end_refused", "payload": {"op": "write_arrangement_clip", "track": "BASS", "start_beat": 0, "length_beats": 4, "name": "X", "notes": [{"pitch": 60, "start": 5, "duration": 1, "velocity": 100}]}, "expect": "refused", "reason_contains": "clip end"},
    {"id": "zero_duration_refused", "payload": {"op": "write_arrangement_clip", "track": "BASS", "start_beat": 0, "length_beats": 4, "name": "X", "notes": [{"pitch": 60, "start": 0, "duration": 0, "velocity": 100}]}, "expect": "refused", "reason_contains": "duration"},
    {"id": "velocity_out_of_range_refused", "payload": {"op": "write_arrangement_clip", "track": "BASS", "start_beat": 0, "length_beats": 4, "name": "X", "notes": [{"pitch": 60, "start": 0, "duration": 1, "velocity": 0}]}, "expect": "refused", "reason_contains": "velocity"},
    {"id": "user_clip_overlap_refused_by_default", "payload": {"op": "write_arrangement_clip", "track": "BASS", "start_beat": 40, "length_beats": 8, "name": "user riff", "notes": [{"pitch": 60, "start": 0, "duration": 1, "velocity": 100}]}, "expect": "refused", "reason_contains": "not written by Loom"},
    {"id": "user_clip_overlap_refused_even_with_replace_owned", "payload": {"op": "write_arrangement_clip", "track": "BASS", "start_beat": 40, "length_beats": 8, "name": "user riff", "on_conflict": "replace_owned", "notes": [{"pitch": 60, "start": 0, "duration": 1, "velocity": 100}]}, "expect": "refused", "reason_contains": "not written by Loom"},
    {"id": "owned_clip_overlap_refused_without_policy", "payload": {"op": "write_arrangement_clip", "track": "BASS", "start_beat": 64, "length_beats": 16, "name": "Verse", "notes": [{"pitch": 60, "start": 0, "duration": 1, "velocity": 100}]}, "expect": "refused", "reason_contains": "on_conflict"},
    {"id": "owned_clip_replaced_with_replace_owned", "payload": {"op": "write_arrangement_clip", "track": "BASS", "start_beat": 64, "length_beats": 16, "name": "Verse", "on_conflict": "replace_owned", "notes": [{"pitch": 60, "start": 0, "duration": 1, "velocity": 100}]}, "expect": "written", "replaced": 1, "clip_count": 2},
    {"id": "free_range_written", "payload": {"op": "write_arrangement_clip", "track": "BASS", "start_beat": 96, "length_beats": 8, "name": "Outro", "notes": [{"pitch": 60, "start": 0, "duration": 1, "velocity": 100}]}, "expect": "written", "replaced": 0, "clip_count": 3},
    {"id": "session_occupied_slot_refused", "payload": {"op": "write_clip", "track": "BASS", "slot": 0, "name": "X", "length_beats": 4, "notes": [{"pitch": 60, "start": 0, "duration": 1, "velocity": 100}]}, "expect": "refused", "reason_contains": "occupied"},
    {"id": "session_empty_slot_written", "payload": {"op": "write_clip", "track": "BASS", "slot": 1, "name": "X", "length_beats": 4, "notes": [{"pitch": 60, "start": 0, "duration": 1, "velocity": 100}]}, "expect": "written"}
  ]
}
